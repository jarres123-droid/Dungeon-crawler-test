extends Node3D

# Dungeon Textures v1 - texture existing procedural geometry IN PLACE.
# Attach this to a NEW child Node3D named DungeonTextures under Dungeon.
# Leave the Dungeon root generator and existing DungeonArt script alone.
# PNG textures must live under res://dungeon_textures/.

@export var texture_art_decorations: bool = true
@export var texture_wood_and_iron: bool = true
@export_range(1, 8, 1) var wall_repeat: int = 3
@export_range(1, 6, 1) var floor_repeat: int = 1

var _textures: Dictionary = {}
var _materials: Dictionary = {}
var _walls_changed: int = 0
var _floors_changed: int = 0
var _art_changed: int = 0


func _ready() -> void:
    # Parent generator and sibling DungeonArt build their geometry at startup.
    # Wait two frames, then update all generated meshes without touching collision.
    call_deferred("_apply_when_ready")


func _apply_when_ready() -> void:
    await get_tree().process_frame
    await get_tree().process_frame
    if not is_inside_tree():
        return
    if not _load_textures():
        return
    _create_materials()
    _apply_to_generator()
    if texture_art_decorations:
        _apply_to_dungeon_art()
    print("Dungeon Textures v1: floors=%d, generator props=%d, art batches=%d" % [
        _floors_changed, _walls_changed, _art_changed
    ])


func _load_textures() -> bool:
    var names: Array[String] = [
        "floor_worn", "floor_bluegray", "floor_cracked", "floor_mossy",
        "wall_weathered", "wall_mossy", "wood_aged", "iron_worn"
    ]
    for key in names:
        var path: String = "res://dungeon_textures/%s.png" % key
        var texture: Texture2D = load(path) as Texture2D
        if texture == null:
            push_error("DungeonTextures: missing %s; put the dungeon_textures folder in your Godot project." % path)
            return false
        _textures[key] = texture
    return true


func _make_material(texture_key: String, repeat: Vector3, roughness: float = 0.94) -> StandardMaterial3D:
    var mat: StandardMaterial3D = StandardMaterial3D.new()
    mat.albedo_texture = _textures[texture_key]
    mat.uv1_scale = repeat
    mat.roughness = roughness
    var surface_key: String = "dungeon_floor"
    if texture_key.begins_with("wall"):
        surface_key = "dungeon_wall"
    elif texture_key == "wood_aged":
        surface_key = "oak_timber"
    elif texture_key == "iron_worn":
        surface_key = "aged_iron"
    var surface_root := "res://assets/textures/premium/%s_" % surface_key
    mat.normal_enabled = true
    mat.normal_texture = load(surface_root + "normal.png") as Texture2D
    mat.normal_scale = 0.68 if surface_key.begins_with("dungeon") else 0.55
    mat.roughness_texture = load(surface_root + "roughness.png") as Texture2D
    mat.texture_filter = BaseMaterial3D.TEXTURE_FILTER_LINEAR_WITH_MIPMAPS_ANISOTROPIC
    if texture_key == "iron_worn":
        mat.metallic = 0.62
        mat.metallic_specular = 0.72
    return mat


func _create_materials() -> void:
    var ft: float = float(floor_repeat)
    var wt: float = float(wall_repeat)
    _materials["floor0"] = _make_material("floor_worn", Vector3(ft, ft, ft))
    _materials["floor1"] = _make_material("floor_bluegray", Vector3(ft, ft, ft))
    _materials["floor2"] = _make_material("floor_cracked", Vector3(ft, ft, ft))
    _materials["floor3"] = _make_material("floor_mossy", Vector3(ft, ft, ft))
    _materials["wall"] = _make_material("wall_weathered", Vector3(wt, wt, wt))
    _materials["wall_moss"] = _make_material("wall_mossy", Vector3(wt, wt, wt))
    _materials["stone_trim"] = _make_material("floor_cracked", Vector3(1.0, 1.0, 1.0))
    _materials["base_floor"] = _make_material("floor_bluegray", Vector3(4.0, 1.0, 4.0))
    _materials["wood"] = _make_material("wood_aged", Vector3(1.0, 1.0, 1.0))
    _materials["iron"] = _make_material("iron_worn", Vector3(1.0, 1.0, 1.0), 0.59)


func _apply_to_generator() -> void:
    var root: Node = get_parent()
    if root == null:
        push_error("DungeonTextures: attach under the procedural Dungeon root.")
        return
    for item in root.get_children():
        if item == self:
            continue
        if item is MultiMeshInstance3D and String(item.name).begins_with("Batched floor tiles "):
            # Four floor-tile groups generated by dungeon_procedural_v1.gd.
            var group: int = String(item.name).get_slice(" ", 3).to_int()
            if group >= 0 and group <= 3:
                var multi_item: MultiMeshInstance3D = item as MultiMeshInstance3D
                multi_item.material_override = _materials["floor%d" % group]
                _floors_changed += 1
            continue
        if not (item is Node3D):
            continue
        var name: String = String(item.name)
        var mat: Material = null
        if name.begins_with("Floor ") or name == "Corridor floor":
            mat = _materials["base_floor"]
        elif name == "Solid room wall" or name.begins_with("Door wall") or name == "Corridor parapet":
            mat = _materials["wall"]
        elif name == "Stone door lintel" or name.begins_with("Column"):
            mat = _materials["stone_trim"]
        elif texture_wood_and_iron and (name == "Loot chest body" or name == "Wall torch bracket"):
            mat = _materials["wood"]
        elif texture_wood_and_iron and (name == "Loot chest lid" or name == "Chest lock"):
            mat = _materials["iron"]
        if mat != null:
            for child in item.get_children():
                if child is MeshInstance3D:
                    var mesh_item: MeshInstance3D = child as MeshInstance3D
                    mesh_item.material_override = mat
                    _walls_changed += 1


func _apply_to_dungeon_art() -> void:
    # The user's original node may be named DungeonArt or dungeonart.
    # Discover it by generated mesh naming, not a case-sensitive node path.
    var art_node: Node = null
    for possible in get_parent().get_children():
        if possible == self or not (possible is Node3D):
            continue
        for nested in possible.get_children():
            if nested is MultiMeshInstance3D and String(nested.name).begins_with("Dungeon Art "):
                art_node = possible
                break
        if art_node != null:
            break
    if art_node == null:
        push_warning("DungeonTextures: DungeonArt mesh batches not found; base floor and walls were still textured.")
        return
    # v2/v3 decorative parts are batched into separate stone/wood/iron meshes.
    # Only swap the visuals, never the physical bodies or tile positions.
    for item in art_node.get_children():
        if not (item is MultiMeshInstance3D):
            continue
        var name: String = String(item.name)
        if not name.begins_with("Dungeon Art "):
            continue
        var pipe: int = name.find("|")
        if pipe == -1:
            continue
        var tint: String = name.substr(pipe + 1)
        var replacement: Material = null
        match tint:
            "stone0", "stone1", "stone2":
                replacement = _materials["wall"]
            "stone3", "stone4":
                replacement = _materials["wall_moss"] if tint == "stone3" else _materials["stone_trim"]
            "wood", "wood2", "wood3":
                if texture_wood_and_iron:
                    replacement = _materials["wood"]
            "iron", "iron2":
                if texture_wood_and_iron:
                    replacement = _materials["iron"]
        if replacement != null:
            var decorative_mesh: MultiMeshInstance3D = item as MultiMeshInstance3D
            decorative_mesh.material_override = replacement
            _art_changed += 1
